bootstrap_independent <- function(x1, x2, B = 1000) {
n1 <- length(x1)
n2 <- length(x2)
resampled_means <- replicate(B, {
mean1 <- mean(sample(x1, size = n1, replace = TRUE))
mean2 <- mean(sample(x2, size = n2, replace = TRUE))
mean1 - mean2
})
resampled_means
}
set.seed(12427550)
independent_bootstrap <- bootstrap_independent(x1, x2)
summary(independent_bootstrap)
bootstrap_pooled <- function(x1, x2, B = 1000) {
combined <- c(x1, x2)
centered <- combined - mean(combined)
n1 <- length(x1)
n2 <- length(x2)
resampled_means <- replicate(B, {
resample1 <- sample(centered, size = n1, replace = TRUE)
resample2 <- sample(centered, size = n2, replace = TRUE)
mean(resample1) - mean(resample2)
})
resampled_means
}
set.seed(12427550)
pooled_bootstrap <- bootstrap_pooled(x1, x2)
summary(pooled_bootstrap)
bootstrap_test <- function(x1, x2, B = 10000, alpha = 0.05, method = "independent") {
if (!is.numeric(x1) || !is.numeric(x2)) stop("Both x1 and x2 must be numeric vectors.")
if (B <= 0 || !is.numeric(B)) stop("Number of bootstrap samples (B) must be a positive integer.")
n1 <- length(x1)
n2 <- length(x2)
observed_stat <- tryCatch(t.test(x1, x2)$statistic,
error = function(e) stop("Error in calculating observed t-statistic:", e))
bootstrap_stats <- numeric(B)
if (method == "independent") {
for (i in 1:B) {
sample_x1 <- sample(x1, size = n1, replace = TRUE)
sample_x2 <- sample(x2, size = n2, replace = TRUE)
bootstrap_stats[i] <- tryCatch(t.test(sample_x1, sample_x2)$statistic,
error = function(e) NA)
}
} else if (method == "pooled") {
combined <- c(x1, x2)
centered <- combined - mean(combined)
for (i in 1:B) {
resample_x1 <- sample(centered, size = n1, replace = TRUE)
resample_x2 <- sample(centered, size = n2, replace = TRUE)
bootstrap_stats[i] <- tryCatch(t.test(resample_x1, resample_x2)$statistic,
error = function(e) NA)
}
} else {
stop("Invalid method. Use 'independent' or 'pooled'.")
}
p_value <- mean(abs(bootstrap_stats) >= abs(observed_stat), na.rm = TRUE)
ci <- quantile(bootstrap_stats, probs = c(alpha / 2, 1 - alpha / 2), na.rm = TRUE)
list(p_value = p_value, ci = ci, observed_stat = observed_stat)
}
independent_result <- bootstrap_test(x1, x2, method = "independent")
pooled_result <- bootstrap_test(x1, x2, method = "pooled")
independent_result
pooled_result
permutation_test <- function(x1, x2, B = 10000, alpha = 0.05) {
if (!is.numeric(x1) || !is.numeric(x2)) stop("Both x1 and x2 must be numeric vectors.")
if (B <= 0 || !is.numeric(B)) stop("Number of permutations (B) must be a positive integer.")
combined <- c(x1, x2)
n1 <- length(x1)
observed_stat <- tryCatch(t.test(x1, x2)$statistic,
error = function(e) stop("Error in calculating observed t-statistic:", e))
perm_stats <- numeric(B)
for (i in 1:B) {
permuted <- sample(combined)
perm_x1 <- permuted[1:n1]
perm_x2 <- permuted[(n1 + 1):length(permuted)]
perm_stats[i] <- tryCatch(t.test(perm_x1, perm_x2)$statistic, error = function(e) NA)
}
p_value <- mean(abs(perm_stats) >= abs(observed_stat), na.rm = TRUE)
ci <- quantile(perm_stats, probs = c(alpha / 2, 1 - alpha / 2), na.rm = TRUE)
list(p_value = p_value, ci = ci, observed_stat = observed_stat)
}
permutation_result <- permutation_test(x1, x2)
permutation_result
wilcoxon_test <- function(x1, x2, B = 10000, alpha = 0.05, method = "independent") {
if (!is.numeric(x1) || !is.numeric(x2)) stop("Both x1 and x2 must be numeric vectors.")
if (B <= 0 || !is.numeric(B)) stop("Number of bootstrap samples (B) must be a positive integer.")
n1 <- length(x1)
observed_stat <- tryCatch(wilcox.test(x1, x2)$statistic,
error = function(e) stop("Error in calculating observed Wilcoxon statistic:", e))
bootstrap_stats <- numeric(B)
if (method == "independent") {
for (i in 1:B) {
sample_x1 <- sample(x1, size = n1, replace = TRUE)
sample_x2 <- sample(x2, size = length(x2), replace = TRUE)
bootstrap_stats[i] <- tryCatch(wilcox.test(sample_x1, sample_x2)$statistic,
error = function(e) NA)
}
} else if (method == "pooled") {
combined <- c(x1, x2)
centered <- combined - mean(combined)
for (i in 1:B) {
resample_x1 <- sample(centered, size = n1, replace = TRUE)
resample_x2 <- sample(centered, size = length(x2), replace = TRUE)
bootstrap_stats[i] <- tryCatch(wilcox.test(resample_x1, resample_x2)$statistic,
error = function(e) NA)
}
} else {
stop("Invalid method. Use 'independent' or 'pooled'.")
}
p_value <- mean(bootstrap_stats >= observed_stat, na.rm = TRUE)
ci <- quantile(bootstrap_stats, probs = c(alpha / 2, 1 - alpha / 2), na.rm = TRUE)
list(p_value = p_value, ci = ci, observed_stat = observed_stat)
}
wilcoxon_independent <- wilcoxon_test(x1, x2, method = "independent")
wilcoxon_pooled <- wilcoxon_test(x1, x2, method = "pooled")
wilcoxon_independent
wilcoxon_pooled
t_test_result <- t.test(x1, x2)
wilcox_test_result <- wilcox.test(x1, x2)
list(
t_test = t_test_result,
wilcox_test = wilcox_test_result,
