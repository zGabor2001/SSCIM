})
apply(coef_boot, 1, function(coef) quantile(coef, probs = c(0.025, 0.975)))
}, error = function(e) stop("Error in pairs bootstrap: ", e$message))
}
pairs_ci <- pairs_bootstrap(data)
list(residual_ci = residual_ci, pairs_ci = pairs_ci)
residual_x3_ci <- residual_ci[", x3"]
pairs_x3_ci <- pairs_ci[ ,"x3"]
print("Confidence Interval for x3 (Residual Bootstrap):")
print(residual_x3_ci)
print("Confidence Interval for x3 (Pairs Bootstrap):")
print(pairs_x3_ci)
exclude_x3_residual <- all(residual_x3_ci > 0) || all(residual_x3_ci < 0)
exclude_x3_pairs <- all(pairs_x3_ci > 0) || all(pairs_x3_ci < 0)
cat("Can x3 be excluded using Residual Bootstrap?", exclude_x3_residual, "\n")
cat("Can x3 be excluded using Pairs Bootstrap?", exclude_x3_pairs, "\n")
residual_x3_ci <- residual_ci[", x3"]
pairs_x3_ci <- pairs_ci[ ,"x3"]
print("Confidence Interval for x3 (Residual Bootstrap):")
print(residual_x3_ci)
print("Confidence Interval for x3 (Pairs Bootstrap):")
print(pairs_x3_ci)
exclude_x3_residual <- all(residual_x3_ci > 0) || all(residual_x3_ci < 0)
exclude_x3_pairs <- all(pairs_x3_ci > 0) || all(pairs_x3_ci < 0)
