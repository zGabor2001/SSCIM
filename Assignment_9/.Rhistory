knitr::opts_chunk$set(echo = TRUE)
# Load necessary library
library(coda)
# Define parameters
rho <- 0.5   # Correlation
mu <- c(0, 0) # Mean vector
sigma <- matrix(c(1, rho, rho, 1), nrow = 2) # Covariance matrix
M <- 30000   # Chain size
# Initialize Gibbs sampler
theta <- matrix(0, nrow = M, ncol = 2) # Storage for samples
theta[1, ] <- c(0, 0) # Initial values
# Gibbs sampler function
gibbs_sampler <- function(mu, sigma, rho, M) {
samples <- matrix(0, nrow = M, ncol = 2)
samples[1, ] <- c(0, 0) # Initial values
for (i in 2:M) {
# Sample θ1 | θ2
mu1_given_2 <- mu[1] + rho * (samples[i-1, 2] - mu[2])
var1_given_2 <- 1 - rho^2
samples[i, 1] <- rnorm(1, mean = mu1_given_2, sd = sqrt(var1_given_2))
# Sample θ2 | θ1
mu2_given_1 <- mu[2] + rho * (samples[i, 1] - mu[1])
var2_given_1 <- 1 - rho^2
samples[i, 2] <- rnorm(1, mean = mu2_given_1, sd = sqrt(var2_given_1))
}
return(samples)
}
# Run the Gibbs sampler
theta_samples <- gibbs_sampler(mu, sigma, rho, M)
# Perform diagnostics
# Convert samples to MCMC object
mcmc_chain <- mcmc(theta_samples)
# Trace plots
par(mfrow = c(2, 1))
plot(mcmc_chain[, 1], type = "l", main = expression(theta[1]), ylab = "Value", xlab = "Iteration")
plot(mcmc_chain[, 2], type = "l", main = expression(theta[2]), ylab = "Value", xlab = "Iteration")
# Autocorrelation plots
par(mfrow = c(2, 1))
acf(mcmc_chain[, 1], main = expression("ACF of " ~ theta[1]))
acf(mcmc_chain[, 2], main = expression("ACF of " ~ theta[2]))
# Summary statistics
summary(mcmc_chain)
effectiveSize(mcmc_chain)
# Diagnostics output
gelman.diag(mcmc_chain)
library(coda)
rho <- 0.5
mu <- c(0, 0)
sigma <- matrix(c(1, rho, rho, 1), nrow = 2)
M <- 30000
gibbs_sampler <- function(mu, sigma, rho, M, init) {
samples <- matrix(0, nrow = M, ncol = 2)
samples[1, ] <- init
for (i in 2:M) {
mu1_given_2 <- mu[1] + rho * (samples[i-1, 2] - mu[2])
var1_given_2 <- 1 - rho^2
samples[i, 1] <- rnorm(1, mean = mu1_given_2, sd = sqrt(var1_given_2))
mu2_given_1 <- mu[2] + rho * (samples[i, 1] - mu[1])
var2_given_1 <- 1 - rho^2
samples[i, 2] <- rnorm(1, mean = mu2_given_1, sd = sqrt(var2_given_1))
}
return(samples)
}
set.seed(123)
chain1 <- gibbs_sampler(mu, sigma, rho, M, c(0, 0))
chain2 <- gibbs_sampler(mu, sigma, rho, M, c(1, 1))
mcmc_chain1 <- mcmc(chain1)
mcmc_chain2 <- mcmc(chain2)
mcmc_list <- mcmc.list(mcmc_chain1, mcmc_chain2)
par(mfrow = c(2, 2))
plot(mcmc_chain1[, 1], type = "l", main = expression("Chain 1: " ~ theta[1]), ylab = "Value", xlab = "Iteration")
plot(mcmc_chain2[, 1], type = "l", main = expression("Chain 2: " ~ theta[1]), ylab = "Value", xlab = "Iteration")
plot(mcmc_chain1[, 2], type = "l", main = expression("Chain 1: " ~ theta[2]), ylab = "Value", xlab = "Iteration")
plot(mcmc_chain2[, 2], type = "l", main = expression("Chain 2: " ~ theta[2]), ylab = "Value", xlab = "Iteration")
gelman_diag <- gelman.diag(mcmc_list)
print(gelman_diag)
summary(mcmc_list)
par(mfrow = c(2, 2))
acf(mcmc_chain1[, 1], main = expression("ACF Chain 1: " ~ theta[1]))
acf(mcmc_chain2[, 1], main = expression("ACF Chain 2: " ~ theta[1]))
acf(mcmc_chain1[, 2], main = expression("ACF Chain 1: " ~ theta[2]))
acf(mcmc_chain2[, 2], main = expression("ACF Chain 2: " ~ theta[2]))
library(coda)
rho <- 0.5
mu <- c(0, 0)
sigma <- matrix(c(1, rho, rho, 1), nrow = 2)
M <- 30000
gibbs_sampler <- function(mu, sigma, rho, M, init) {
if (!is.numeric(mu) || length(mu) != 2) {
stop("mu must be a numeric vector of length 2.")
}
if (!is.matrix(sigma) || nrow(sigma) != 2 || ncol(sigma) != 2) {
stop("sigma must be a 2x2 matrix.")
}
if (!is.numeric(rho) || rho < -1 || rho > 1) {
stop("rho must be a numeric value between -1 and 1.")
}
if (!is.numeric(M) || M <= 0 || M != as.integer(M)) {
stop("M must be a positive integer.")
}
if (!is.numeric(init) || length(init) != 2) {
stop("init must be a numeric vector of length 2.")
}
if (det(sigma) <= 0) {
stop("Covariance matrix sigma must be positive semi-definite.")
}
samples <- matrix(0, nrow = M, ncol = 2)
samples[1, ] <- init
for (i in 2:M) {
tryCatch({
mu1_given_2 <- mu[1] + rho * (samples[i-1, 2] - mu[2])
var1_given_2 <- 1 - rho^2
if (var1_given_2 <= 0) stop("Variance for theta_1 given theta_2 must be positive.")
samples[i, 1] <- rnorm(1, mean = mu1_given_2, sd = sqrt(var1_given_2))
mu2_given_1 <- mu[2] + rho * (samples[i, 1] - mu[1])
var2_given_1 <- 1 - rho^2
if (var2_given_1 <= 0) stop("Variance for theta_2 given theta_1 must be positive.")
samples[i, 2] <- rnorm(1, mean = mu2_given_1, sd = sqrt(var2_given_1))
}, error = function(e) {
cat("Error in iteration", i, ": ", e$message, "\n")
return(NULL)
})
}
return(samples)
}
