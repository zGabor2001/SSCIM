}, error = function(e) {
stop("Error generating random points: ", e$message)
})
if (nrow(random_points) == 0) {
stop("Error: No random points were generated.")
}
if (!all(random_points$inside %in% c(0, 1))) {
stop("Error: 'inside' column in random points must contain 0s or 1s.")
}
inside_percentage <- mean(random_points$inside) * 100
bounding_box_area <- (3.5 + 2) * (3 + 3)
if (bounding_box_area <= 0) {
stop("Error: Calculated bounding box area is non-positive.")
}
estimated_area <- mean(random_points$inside) * bounding_box_area
return(list(inside_percentage = inside_percentage, estimated_area = estimated_area))
}
sample_sizes <- c(100, 1000, 10000, 100000)
results <- data.frame(Sample_Size = sample_sizes,
Inside_Percentage = numeric(4),
Estimated_Area = numeric(4))
results[ , 2:3] <- lapply(sample_sizes, function(n) {
tryCatch({
area_results <- estimate_area(n)
return(c(area_results$inside_percentage, area_results$estimated_area))
}, error = function(e) {
cat("Error while estimating area for sample size", n, ": ", e$message, "\n")
return(c(NA, NA))
})
})
if (any(is.na(results$Estimated_Area))) {
warning("Some area estimates are missing due to errors during estimation.")
}
t_vals <- seq(-pi, pi, length.out = 1000)
polar_coords <- tryCatch({
t(sapply(t_vals, polar_to_cartesian))
}, error = function(e) {
stop("Error in converting polar to Cartesian coordinates: ", e$message)
})
x_vals <- polar_coords[, 1]
y_vals <- polar_coords[, 2]
random_points_large <- tryCatch({
generate_random_points(100000)
}, error = function(e) {
stop("Error generating random points for large sample size: ", e$message)
})
ggplot() +
geom_path(aes(x = x_vals, y = y_vals), color = "blue", size = 1) +
geom_point(data = random_points_large, aes(x = x, y = y, color = factor(inside)), size = 0.5) +
scale_color_manual(values = c("red", "green"), labels = c("Outside", "Inside")) +
coord_fixed() +
theme_minimal() +
labs(title = "Random Points Inside/Outside the Enclosed Area",
x = "X", y = "Y", color = "Point Status") +
theme(legend.position = "bottom")
ggplot(results, aes(x = Sample_Size, y = Estimated_Area)) +
geom_line(color = "blue") +
geom_point(color = "red") +
scale_x_log10() +
labs(title = "Estimated Area vs Sample Size",
x = "Sample Size (log scale)", y = "Estimated Area") +
theme_minimal()
generate_random_points <- function(n_samples) {
if (!is.numeric(n_samples) || n_samples <= 0) {
stop("Error: n_samples must be a positive integer.")
}
x_random <- tryCatch({
runif(n_samples, -2, 3.5)
}, error = function(e) {
stop("Error generating x_random: ", e$message)
})
y_random <- tryCatch({
runif(n_samples, -3, 3)
}, error = function(e) {
stop("Error generating y_random: ", e$message)
})
inside_area <- tryCatch({
as.integer(sapply(1:n_samples, function(i) {
distance_from_origin <- sqrt(x_random[i]^2 + y_random[i]^2)
distance_from_origin <= r_function(atan2(y_random[i], x_random[i]))
}))
}, error = function(e) {
stop("Error calculating inside_area: ", e$message)
})
if (length(inside_area) != n_samples) {
stop("Error: The number of inside_area values does not match n_samples.")
}
data.frame(x = x_random, y = y_random, inside = inside_area)
}
n_samples <- 1000
random_points <- tryCatch({
generate_random_points(n_samples)
}, error = function(e) {
stop("Error generating random points: ", e$message)
})
t_vals <- seq(-pi, pi, length.out = 1000)
polar_coords <- tryCatch({
t(sapply(t_vals, polar_to_cartesian))
}, error = function(e) {
stop("Error in converting polar to Cartesian coordinates: ", e$message)
})
x_vals <- polar_coords[, 1]
y_vals <- polar_coords[, 2]
ggplot() +
geom_path(aes(x = x_vals, y = y_vals), color = "blue", size = 1) +
geom_point(data = random_points, aes(x = x, y = y, color = factor(inside)), size = 0.5) +
scale_color_manual(values = c("red", "green"), labels = c("Outside", "Inside")) +
coord_fixed() +
theme_minimal() +
labs(title = "Random Points Inside/Outside the Enclosed Area",
x = "X", y = "Y", color = "Point Status") +
theme(legend.position = "bottom")
r_function <- function(t) {
tryCatch({
exp(cos(t)) - 2 * cos(4 * t) - sin(t / 12)^5
}, error = function(e) {
stop("Error in r_function: ", e$message)
})
}
polar_to_cartesian <- function(t) {
tryCatch({
r <- r_function(t)
c(r * cos(t), r * sin(t))
}, error = function(e) {
stop("Error in polar_to_cartesian: ", e$message)
})
}
monte_carlo_area <- function(n_samples) {
if (!is.numeric(n_samples) || n_samples <= 0) {
stop("Error: n_samples must be a positive integer.")
}
t_samples <- tryCatch({
runif(n_samples, -pi, pi)
}, error = function(e) {
stop("Error generating t_samples: ", e$message)
})
points <- tryCatch({
t(sapply(t_samples, polar_to_cartesian))
}, error = function(e) {
stop("Error in converting polar to Cartesian: ", e$message)
})
x_min <- min(points[, 1])
x_max <- max(points[, 1])
y_min <- min(points[, 2])
y_max <- max(points[, 2])
random_points <- tryCatch({
cbind(runif(n_samples, x_min, x_max), runif(n_samples, y_min, y_max))
}, error = function(e) {
stop("Error generating random_points: ", e$message)
})
inside_area <- tryCatch({
sum(apply(random_points, 1, function(p) {
sqrt(p[1]^2 + p[2]^2) <= max(sapply(t_samples, r_function))
}))
}, error = function(e) {
stop("Error calculating inside_area: ", e$message)
})
area_estimate <- (inside_area / n_samples) * (x_max - x_min) * (y_max - y_min)
return(area_estimate)
}
t_vals <- seq(-pi, pi, length.out = 1000)
polar_coords <- tryCatch({
t(sapply(t_vals, polar_to_cartesian))
}, error = function(e) {
stop("Error in converting polar to Cartesian: ", e$message)
})
x_vals <- polar_coords[, 1]
y_vals <- polar_coords[, 2]
ggplot() +
geom_path(aes(x = x_vals, y = y_vals), color = "blue", size = 1) +
coord_fixed() +
theme_minimal() +
labs(title = "Polar Curve and Enclosed Area", x = "X", y = "Y")
n_samples <- 100
estimated_area <- tryCatch({
monte_carlo_area(n_samples)
}, error = function(e) {
stop("Error estimating area: ", e$message)
})
cat("Estimated Area Enclosed by the Curve:", estimated_area, "\n")
integrand <- function(x) {
tryCatch({
exp(-x^3)
}, error = function(e) {
stop("Error in integrand function: ", e$message)
})
}
monte_carlo_integration_inf <- function(n_samples) {
if (!is.numeric(n_samples) || n_samples <= 0) {
stop("Error: n_samples must be a positive integer.")
}
samples <- tryCatch({
rexp(n_samples, 1)
}, error = function(e) {
stop("Error generating samples: ", e$message)
})
tryCatch({
mean(integrand(samples) * exp(samples))
}, error = function(e) {
stop("Error in Monte Carlo integration: ", e$message)
})
}
n_samples <- 10000
monte_carlo_result <- tryCatch({
monte_carlo_integration_inf(n_samples)
}, error = function(e) {
stop("Error calculating Monte Carlo result: ", e$message)
})
exact_value <- tryCatch({
integrate(integrand, 0, Inf)$value
}, error = function(e) {
stop("Error calculating exact value: ", e$message)
})
cat("Monte Carlo Estimate for b=Inf:", monte_carlo_result, "\n")
cat("Exact Value for b=Inf:", exact_value, "\n")
integrand <- function(x) {
tryCatch({
exp(-x^3)
}, error = function(e) {
stop("Error in integrand function: ", e$message)
})
}
monte_carlo_integration <- function(n_samples, b) {
if (!is.numeric(n_samples) || n_samples <= 0) {
stop("Error: n_samples must be a positive integer.")
}
if (!is.numeric(b) || b <= 0) {
stop("Error: b must be a positive number.")
}
tryCatch({
estimate <- b * mean(integrand(runif(n_samples, 0, b)))
return(estimate)
}, error = function(e) {
stop("Error in Monte Carlo integration: ", e$message)
})
}
n_samples <- 10000
b <- 6
monte_carlo_result <- tryCatch({
monte_carlo_integration(n_samples, b)
}, error = function(e) {
stop("Error calculating Monte Carlo result: ", e$message)
})
exact_value <- tryCatch({
integrate(integrand, 0, b)$value
}, error = function(e) {
stop("Error calculating exact value: ", e$message)
})
cat("Monte Carlo Estimate for b=6:", monte_carlo_result, "\n")
cat("Exact Value for b=6:", exact_value, "\n")
