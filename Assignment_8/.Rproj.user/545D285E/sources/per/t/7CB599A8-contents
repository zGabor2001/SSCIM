### 2.2 Build the corresponding normal model the regression inference. Obtain the theoretical posterior distribution for both parameters separately assuming the other one to be "known".

In this part of the task, we build the Bayesian normal regression model for inference on the linear relationship between the dependent variable and the explanatory variable. By assuming normal distributions for both the regression coefficient (β) and the residual variance (σ2), we can derive the theoretical posterior distributions for these parameters. The derivation involves updating our prior beliefs based on the observed data, while treating one parameter as fixed to obtain the posterior for the other. This approach allows us to compute the posterior distribution for β assuming σ2 is known, and vice versa, facilitating a deeper understanding of the relationship between these parameters in the regression context.

``` {r}
check_input_data <- function(Auto, tau2_prior, alpha_prior, beta_prior) {
  if (is.null(Auto) || nrow(Auto) == 0) {
    stop("The dataset 'Auto' is either null or empty.")
  }
  if (tau2_prior <= 0) {
    stop("Prior value 'tau2_prior' must be positive.")
  }
  if (alpha_prior <= 0 || beta_prior <= 0) {
    stop("Both 'alpha_prior' and 'beta_prior' must be positive.")
  }
}

perform_bayesian_regression <- function(Auto, tau2_prior, alpha_prior, beta_prior) {
  check_input_data(Auto, tau2_prior, alpha_prior, beta_prior)
  
  tryCatch({
    X <- cbind(1, Auto$horsepower)
    y <- Auto$mpg
    n <- length(y)
    p <- ncol(X)

    if (n != nrow(X)) {
      stop("The number of rows in X must match the length of y.")
    }

    sigma2_known <- 1
    
    V_post <- solve(t(X) %*% X / sigma2_known + diag(1 / tau2_prior, p))
    mu_post <- V_post %*% (t(X) %*% y / sigma2_known)

    residuals <- y - X %*% solve(t(X) %*% X) %*% t(X) %*% y
    alpha_post <- alpha_prior + n / 2
    beta_post <- beta_prior + sum(residuals^2) / 2

    list(V_post = V_post, 
         mu_post = mu_post, 
         alpha_post = alpha_post, 
         beta_post = beta_post,
         X = X,
         y = y,
         n = n,
         p = p)

  }, error = function(e) {
    cat("Error in Bayesian regression computation: ", e$message, "\n")
    return(NULL)
  })
}

tau2_prior <- 1e6
alpha_prior <- 0.001
beta_prior <- 0.001

bayesian_results <- perform_bayesian_regression(Auto, tau2_prior, alpha_prior, beta_prior)

if (!is.null(bayesian_results)) {
  bayesian_results$V_post
  bayesian_results$mu_post
  bayesian_results$alpha_post
  bayesian_results$beta_post
} else {
  cat("Bayesian regression could not be computed due to an error.\n")
}

V_post <- bayesian_results$V_post
mu_post <- bayesian_results$mu_post
alpha_post <- bayesian_results$alpha_post
beta_post <- bayesian_results$beta_post
X <- bayesian_results$X
y <- bayesian_results$y
n <- bayesian_results$n
p <- bayesian_results$p

```

