check_beta_parameters(alpha_posterior, beta_posterior)
tryCatch({
dbeta(p, alpha_posterior, beta_posterior)
}, error = function(e) {
cat("Error in calculating posterior density: ", e$message, "\n")
return(rep(NA, length(p)))
})
}
tryCatch({
p <- seq(0, 0.01, length.out = 1000)
posterior_values <- posterior_density(p, alpha_posterior, beta_posterior)
if (any(is.na(posterior_values))) {
stop("Posterior density calculation resulted in NA values.")
