if (any(is.na(posterior_values))) {
stop("Posterior density calculation resulted in NA values.")
}
ggplot(data = data.frame(p, posterior_values), aes(x = p, y = posterior_values)) +
geom_line(color = "blue") +
labs(title = "Posterior Density of Covid19 Prevalence",
x = "Prevalence (proportion)",
y = "Density") +
theme_minimal()
}, error = function(e) {
cat("Error in generating plot: ", e$message, "\n")
})
check_beta_parameters <- function(alpha, beta) {
if (alpha <= 0 || beta <= 0) {
stop("Both 'alpha_posterior' and 'beta_posterior' must be greater than zero.")
}
}
calculate_posterior_statistics <- function(alpha_posterior, beta_posterior) {
check_beta_parameters(alpha_posterior, beta_posterior)
tryCatch({
mean_prevalence <- alpha_posterior / (alpha_posterior + beta_posterior)
mode_prevalence <- ifelse(alpha_posterior > 1,
(alpha_posterior - 1) / (alpha_posterior + beta_posterior - 2),
NA)
hpd_samples <- rbeta(100000, alpha_posterior, beta_posterior)
hpd_interval <- HPDinterval(as.mcmc(hpd_samples), prob = 0.95)
list(mean = mean_prevalence, mode = mode_prevalence, hpd = hpd_interval)
}, error = function(e) {
cat("Error in calculating posterior statistics: ", e$message, "\n")
return(NULL)
})
}
posterior_results <- calculate_posterior_statistics(alpha_posterior, beta_posterior)
if (!is.null(posterior_results)) {
posterior_results$mean
posterior_results$mode
posterior_results$hpd
} else {
cat("Posterior statistics could not be computed due to an error.\n")
}
mu_prior <- 0
tau2_prior <- 1e6
alpha_prior <- 0.001
beta_prior <- 0.001
check_input_data <- function(Auto, tau2_prior, alpha_prior, beta_prior) {
if (is.null(Auto) || nrow(Auto) == 0) {
stop("The dataset 'Auto' is either null or empty.")
}
if (tau2_prior <= 0) {
stop("Prior value 'tau2_prior' must be positive.")
}
if (alpha_prior <= 0 || beta_prior <= 0) {
stop("Both 'alpha_prior' and 'beta_prior' must be positive.")
}
}
perform_bayesian_regression <- function(Auto, tau2_prior, alpha_prior, beta_prior) {
check_input_data(Auto, tau2_prior, alpha_prior, beta_prior)
tryCatch({
X <- cbind(1, Auto$horsepower)
y <- Auto$mpg
n <- length(y)
p <- ncol(X)
if (n != nrow(X)) {
stop("The number of rows in X must match the length of y.")
}
sigma2_known <- 1
V_post <- solve(t(X) %*% X / sigma2_known + diag(1 / tau2_prior, p))
mu_post <- V_post %*% (t(X) %*% y / sigma2_known)
residuals <- y - X %*% solve(t(X) %*% X) %*% t(X) %*% y
alpha_post <- alpha_prior + n / 2
beta_post <- beta_prior + sum(residuals^2) / 2
list(V_post = V_post, mu_post = mu_post, alpha_post = alpha_post, beta_post = beta_post)
}, error = function(e) {
cat("Error in Bayesian regression computation: ", e$message, "\n")
return(NULL)
})
}
tau2_prior <- 1e6
alpha_prior <- 0.001
beta_prior <- 0.001
bayesian_results <- perform_bayesian_regression(Auto, tau2_prior, alpha_prior, beta_prior)
