check_input_data <- function(X, y, V_post, mu_post, alpha_post, beta_post) {
if (is.null(X) || nrow(X) == 0 || ncol(X) == 0) {
stop("Design matrix 'X' is either null or empty.")
}
if (is.null(y) || length(y) == 0) {
stop("Response vector 'y' is either null or empty.")
}
if (is.null(V_post) || nrow(V_post) == 0 || ncol(V_post) == 0) {
stop("Posterior covariance matrix 'V_post' is either null or empty.")
}
if (is.null(mu_post) || length(mu_post) == 0) {
stop("Posterior mean vector 'mu_post' is either null or empty.")
}
if (alpha_post <= 0 || beta_post <= 0) {
stop("Both 'alpha_post' and 'beta_post' must be positive.")
}
}
perform_bayesian_inference <- function(X, y, V_post, mu_post, alpha_post, beta_post) {
check_input_data(X, y, V_post, mu_post, alpha_post, beta_post)
tryCatch({
beta_MLE <- solve(t(X) %*% X) %*% t(X) %*% y
beta_95_HPD <- apply(V_post, 2, function(var) {
mean <- mu_post
hpd_lower <- qnorm(0.025, mean, sqrt(var))
hpd_upper <- qnorm(0.975, mean, sqrt(var))
c(hpd_lower, hpd_upper)
})
sigma2_MAP <- beta_post / (alpha_post + 1)
sigma2_95_HPD <- c(
qgamma(0.025, alpha_post, rate = 1 / beta_post),
qgamma(0.975, alpha_post, rate = 1 / beta_post)
)
list(
beta_MLE = beta_MLE,
beta_95_HPD = beta_95_HPD,
sigma2_MAP = sigma2_MAP,
sigma2_95_HPD = sigma2_95_HPD
)
}, error = function(e) {
cat("Error in Bayesian inference computation: ", e$message, "\n")
return(NULL)
})
}
bayesian_inference_results <- perform_bayesian_inference(X, y, V_post, mu_post, alpha_post, beta_post)
beta_MLE <- solve(t(X) %*% X) %*% t(X) %*% y
