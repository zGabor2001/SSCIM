if (!is.numeric(lambdas)) {
stop("Error: lambdas must be a numeric vector.")
}
fit_glmnet <- tryCatch({
glmnet(X_train, y_train, alpha = 1, lambda = lambdas)
}, error = function(e) {
stop("Error: Failed to fit glmnet model. ", e$message)
})
coef_glmnet <- tryCatch({
as.matrix(coef(fit_glmnet))
}, error = function(e) {
stop("Error: Failed to extract coefficients from glmnet model. ", e$message)
})
matplot(lambdas, t(coef_glmnet[-1, , drop = FALSE]), type = "l", lty = 1, col = 1:ncol(X_train),
xlab = "Lambda", ylab = "Coefficients", main = "glmnet Lasso Coefficient Path")
#legend("topright", legend = colnames(X_train), col = 1:ncol(X_train), lty = 1)
if (any(is.na(X_train)) | any(is.na(y_train))) {
stop("Error: X_train or y_train contains missing values.")
}
if (!is.matrix(X_train)) {
stop("Error: X_train must be a numeric matrix.")
}
if (!is.vector(y_train) || !is.numeric(y_train)) {
stop("Error: y_train must be a numeric vector.")
}
if (!is.vector(y_test) || !is.numeric(y_test)) {
stop("Error: y_test must be a numeric vector.")
}
cv_fit_glmnet <- tryCatch({
cv.glmnet(X_train, y_train, alpha = 1)
}, error = function(e) {
stop("Error: Failed to fit Lasso model. ", e$message)
})
lasso_lambda_min <- cv_fit_glmnet$lambda.min
lasso_pred <- tryCatch({
predict(cv_fit_glmnet, s = lasso_lambda_min, newx = X_test)
}, error = function(e) {
stop("Error: Prediction failed for Lasso model. ", e$message)
})
cv_fit_ridge <- tryCatch({
cv.glmnet(X_train, y_train, alpha = 0)
}, error = function(e) {
stop("Error: Failed to fit Ridge model. ", e$message)
})
ridge_lambda_min <- cv_fit_ridge$lambda.min
ridge_pred <- tryCatch({
predict(cv_fit_ridge, s = ridge_lambda_min, newx = X_test)
}, error = function(e) {
stop("Error: Prediction failed for Ridge model. ", e$message)
})
fit_ls <- tryCatch({
glmnet(X_train, y_train, alpha = 1, lambda = 0)
}, error = function(e) {
stop("Error: Failed to fit Least Squares model. ", e$message)
})
ls_pred <- tryCatch({
predict(fit_ls, newx = X_test)
}, error = function(e) {
stop("Error: Prediction failed for Least Squares model. ", e$message)
})
lasso_rmse <- sqrt(mean((y_test - lasso_pred)^2))
ridge_rmse <- sqrt(mean((y_test - ridge_pred)^2))
ls_rmse <- sqrt(mean((y_test - ls_pred)^2))
cat("Lasso RMSE: ", lasso_rmse, "\n")
cat("Ridge RMSE: ", ridge_rmse, "\n")
cat("Least Squares RMSE: ", ls_rmse, "\n")
if (lasso_rmse < ridge_rmse && lasso_rmse < ls_rmse) {
print("Lasso provides the best predictions based on RMSE.")
} else if (ridge_rmse < lasso_rmse && ridge_rmse < ls_rmse) {
print("Ridge regression provides the best predictions based on RMSE.")
} else {
print("Least squares regression provides the best predictions based on RMSE.")
}
# Interpretation:
# The Lasso model tends to perform better when there are many irrelevant predictors because it performs feature selection.
# Ridge regression tends to shrink coefficients but retains all predictors, making it more useful when all variables are expected to contribute.
# The least squares regression does not include regularization, which may lead to overfitting if there are too many predictors.
if (lasso_rmse < ridge_rmse && lasso_rmse < ls_rmse) {
print("Lasso provides the best predictions based on RMSE.")
} else if (ridge_rmse < lasso_rmse && ridge_rmse < ls_rmse) {
print("Ridge regression provides the best predictions based on RMSE.")
} else {
print("Least squares regression provides the best predictions based on RMSE.")
}
# Interpretation:
# The Lasso model tends to perform better when there are many irrelevant predictors because it performs feature selection.
# Ridge regression tends to shrink coefficients but retains all predictors, making it more useful when all variables are expected to contribute.
# The least squares regression does not include regularization, which may lead to overfitting if there are too many predictors.
knitr::opts_chunk$set(echo = TRUE)
library(ISLR)
library(glmnet)
library(caret)
library(ggplot2)
shooting_lasso <- function(X, y, lambda, tol = 1e-6, max_iter = 1000) {
if (!is.matrix(X)) X <- as.matrix(X)
if (!is.numeric(y) || length(y) != nrow(X)) stop("y must be numeric and match the number of rows in X.")
if (!is.numeric(lambda) || lambda < 0) stop("lambda must be a non-negative numeric value.")
n <- nrow(X)
p <- ncol(X)
beta <- rep(0, p)
intercept <- mean(y)
y_centered <- y - intercept
X_centered <- scale(X, center = TRUE, scale = FALSE)
z_j <- colSums(X_centered^2)
for (iter in 1:max_iter) {
beta_old <- beta
for (j in 1:p) {
r_j <- y_centered - X_centered[, -j, drop = FALSE] %*% beta[-j]
rho_j <- sum(X_centered[, j] * r_j)
beta[j] <- sign(rho_j) * max(0, abs(rho_j) - lambda) / z_j[j]
}
if (sqrt(sum((beta - beta_old)^2)) < tol) break
}
if (iter == max_iter) warning("Algorithm did not converge within max_iter.")
return(list(intercept = intercept, coefficients = beta))
}
lasso_path <- function(X, y, lambdas, tol = 1e-6, max_iter = 1000) {
if (!is.matrix(X)) stop("X must be a matrix.")
if (!is.numeric(y) || length(y) != nrow(X)) stop("y must be numeric and match the number of rows in X.")
if (!is.numeric(lambdas) || length(lambdas) == 0) stop("lambdas must be a numeric vector.")
p <- ncol(X)
coef_matrix <- matrix(0, nrow = length(lambdas), ncol = p + 1)
colnames(coef_matrix) <- c("Intercept", paste0("V", 1:p))
for (i in 1:length(lambdas)) {
lambda <- lambdas[i]
fit <- shooting_lasso(X, y, lambda, tol, max_iter)
coef_matrix[i, ] <- c(fit$intercept, fit$coefficients)
}
return(data.frame(lambda = lambdas, coef_matrix))
}
set.seed(12427550)
n <- 100
p <- 10
X <- matrix(rnorm(n * p), n, p)
beta_true <- c(1, -2, 0, 0, 3, rep(0, p - 5))
y <- X %*% beta_true + rnorm(n)
lambdas <- seq(0.1, 1, length.out = 10)
lasso_results <- tryCatch({
lasso_path(X, y, lambdas)
}, error = function(e) {
message("Error in custom LASSO implementation: ", e$message)
NULL
})
fit_glmnet <- tryCatch({
glmnet(X, y, alpha = 1, lambda = lambdas)
}, error = function(e) {
message("Error in glmnet: ", e$message)
NULL
})
if (!is.null(lasso_results)) {
print("Custom LASSO Implementation Coefficients:")
print(lasso_results)
}
if (!is.null(fit_glmnet)) {
coef_glmnet <- as.matrix(coef(fit_glmnet))
print("glmnet Coefficients:")
print(coef_glmnet)
}
cv_lasso <- function(X, y, lambdas, k = 10, tol = 1e-6, max_iter = 1000) {
if (!is.matrix(X)) stop("X must be a matrix.")
if (!is.numeric(y) || length(y) != nrow(X)) stop("y must be numeric and match the number of rows in X.")
if (!is.numeric(lambdas) || length(lambdas) == 0) stop("lambdas must be a numeric vector.")
n <- nrow(X)
folds <- sample(rep(1:k, length.out = n))
mse_matrix <- matrix(NA, nrow = k, ncol = length(lambdas))
for (fold in 1:k) {
train_idx <- which(folds != fold)
test_idx <- which(folds == fold)
X_train <- X[train_idx, , drop = FALSE]
y_train <- y[train_idx]
X_test <- X[test_idx, , drop = FALSE]
y_test <- y[test_idx]
for (i in seq_along(lambdas)) {
lambda <- lambdas[i]
fit <- tryCatch({
shooting_lasso(X_train, y_train, lambda, tol, max_iter)
}, error = function(e) {
message("Error in shooting_lasso: ", e$message)
return(NULL)
})
if (!is.null(fit)) {
y_pred <- X_test %*% fit$coefficients + fit$intercept
mse_matrix[fold, i] <- mean((y_test - y_pred)^2)
}
}
}
mse_avg <- colMeans(mse_matrix, na.rm = TRUE)
lambda_min <- lambdas[which.min(mse_avg)]
return(list(lambda_min = lambda_min, mse = mse_avg, mse_matrix = mse_matrix))
}
cv_results <- tryCatch({
cv_lasso(X, y, lambdas)
}, error = function(e) {
message("Error in cross-validation: ", e$message)
NULL
})
if (!is.null(cv_results)) {
plot(lambdas, cv_results$mse, type = "b", xlab = "Lambda", ylab = "MSE",
main = "10-Fold Cross-Validation")
abline(v = cv_results$lambda_min, col = "red", lty = 2)
}
