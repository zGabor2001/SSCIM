generate_exp_samples <- function(n, lambda) {
uniform_samples <- runif(n)
exp_samples <- -log(uniform_samples) / lambda
return(exp_samples)
}
create_qq_visual <- function(rate_param) {
data_frame <- data.frame(
simulated = generate_exp_samples(1000, rate_param),
theoretical = rexp(1000, rate = rate_param)
)
ggplot(data_frame, aes(sample = simulated)) +
stat_qq(distribution = qexp,
dparams = list(rate = rate_param)) +
stat_qq_line(distribution = qexp, dparams = list(rate = rate_param)) +
ggtitle(sprintf("Exponential Distribution QQ-Plot - rate = %.2f",
rate_param)) +
xlab("Theoretical Quantiles") +
ylab("Simulated Quantiles")
}
rate_list <- c(0.1, 1, 3, 100)
plots_collection <- lapply(rate_list, create_qq_visual)
for (plot_item in plots_collection) {
print(plot_item)
}
knitr::opts_chunk$set(echo = TRUE)
library(ggplot2)
sample_beta_22_ar <- function(n_samples) {
samples <- numeric(n_samples)
c <- 1.5
count <- 0
while (count < n_samples) {
u <- runif(1)
v <- runif(1, 0, c)
f_u <- 6 * u * (1 - u)
if (v < f_u) {
count <- count + 1
samples[count] <- u
}
}
return(samples)
}
n_samples <- 10000
samples_22 <- sample_beta_22_ar(n_samples)
theoretical_quantiles_22 <- qbeta(ppoints(n_samples), 2, 2)
df_22 <- data.frame(
sample_quantiles=sort(samples_22),
theoretical_quantiles=sort(theoretical_quantiles_22)
)
ggplot(df_22, aes(x=theoretical_quantiles, y=sample_quantiles)) +
geom_point(color="blue",
alpha=0.5) +
geom_abline(slope=1,
intercept=0,
color="red",
linetype="dashed") +
ggtitle("Q-Q Plot for Beta(2, 2) Samples") +
xlab("Theoretical Quantiles") +
ylab("Sample Quantiles") +
theme_minimal()
sample_beta_ar <- function(n_samples, alpha, beta) {
samples <- numeric(n_samples)
if (alpha > 1 && beta > 1) {
mode <- (alpha - 1) / (alpha + beta - 2)
} else {
stop("incorrect params")
}
max_f <- dbeta(mode, alpha, beta)
c <- max_f
count <- 0
while (count < n_samples) {
u <- runif(1)
v <- runif(1, 0, c)
f_u <- dbeta(u, alpha, beta)
if (v < f_u) {
count <- count + 1
samples[count] <- u
}
}
return(samples)
}
alpha <- 3
beta <- 5
samples_35 <- sample_beta_ar(n_samples, alpha, beta)
theoretical_quantiles_35 <- qbeta(ppoints(n_samples), alpha, beta)
df_35 <- data.frame(
sample_quantiles=sort(samples_35),
theoretical_quantiles=sort(theoretical_quantiles_35)
)
ggplot(df_35, aes(x=theoretical_quantiles, y=sample_quantiles)) +
geom_point(color="blue",
alpha=0.5) +
geom_abline(slope=1,
intercept=0,
color="red",
linetype="dashed") +
ggtitle(paste("Q-Q Plot for Beta(",
alpha,
",",
beta,
") Samples")) +
xlab("Theoretical Quantiles") +
ylab("Sample Quantiles") +
theme_minimal()
