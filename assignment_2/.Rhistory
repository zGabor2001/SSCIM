linear_congruential_number_generator <- function(n,m,a,c=0,x0)
{
us <- numeric(n)
for (i in 1:n) {
x0 <- (a*x0+c) %% m
us[i] <- x0 / m
}
return(us)
}
n <- 1000
df_1 <- data.frame(
index = 1:n,
value = linear_congruential_number_generator(n,
m=9999999999999999,
a=5769420,
c=57,
x0=12427550
)
)
df_2 <- data.frame(
index = 1:n,
value = linear_congruential_number_generator(n,
m=200000,
a=4,
c=0,
x0=12427550
)
)
df_3 <- data.frame(
index = 1:n,
value = linear_congruential_number_generator(n,
m=5,
a=4,
c=0,
x0=12427550
)
)
library(ggplot2)
plot_1 <- ggplot(df_1, aes(x = index, y = value)) +
geom_point(color = "blue", alpha = 0.5) +
labs(title = "Plot 1: LCG Implementation - Large m",
x = "Index",
y = "Generated Value") +
theme_minimal()
plot_2 <- ggplot(df_2, aes(x = index, y = value)) +
geom_point(color = "orange", alpha = 0.5) +
labs(title = "Plot 2: LCG Implementation - Medium m",
x = "Index",
y = "Generated Value") +
theme_minimal()
plot_3 <- ggplot(df_3, aes(x = index, y = value)) +
geom_point(color = "red", alpha = 0.5) +
labs(title = "Plot 2: LCG Implementation - Small m",
x = "Index",
y = "Generated Value") +
theme_minimal()
plot_1
plot_2
plot_3
