packageurl <- "https://cran.r-project.org/src/contrib/Archive/DPpackage/DPpackage_1.1-7.tar.gz"
install.packages(packageurl, repos=NULL, type="source")
knitr::opts_chunk$set(echo = TRUE)
set.seed(12427550)
n <- 500
x <- runif(n, 0, 1)
w1 <- exp(-2 * x)
w2 <- 1 - w1
y <- numeric(n)
for (i in 1:n) {
if (runif(1) < w1[i]) {
y[i] <- rnorm(1, mean = x[i], sd = sqrt(0.01))
} else {
y[i] <- rnorm(1, mean = x[i]^4, sd = sqrt(0.04))
}
}
data <- data.frame(x = x, y = y)
knitr::opts_chunk$set(echo = TRUE)
library(DPpackage)
install.packages("devtools")
devtools::install_github("Jara-DPpackage/DPpackage")
set.seed(12427550)
n <- 500
x <- runif(n, 0, 1)
w1 <- exp(-2 * x)
w2 <- 1 - w1
y <- numeric(n)
for (i in 1:n) {
if (runif(1) < w1[i]) {
y[i] <- rnorm(1, mean = x[i], sd = sqrt(0.01))
} else {
y[i] <- rnorm(1, mean = x[i]^4, sd = sqrt(0.04))
}
}
data <- data.frame(x = x, y = y)
.libPaths()
find.package("DPpackage")
