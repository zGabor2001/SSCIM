quadratic_model <- lm(mpg ~ poly(horsepower, 2), data = Auto)
cubic_model <- lm(mpg ~ poly(horsepower, 3), data = Auto)
plot(Auto$horsepower,
Auto$mpg,
main = "mpg vs horsepower",
xlab = "Horsepower",
ylab = "MPG",
pch = 16)
lines(Auto$horsepower, predict(linear_model), col = "blue", lwd = 2)
lines(Auto$horsepower, predict(quadratic_model), col = "red", lwd = 2)
lines(Auto$horsepower, predict(cubic_model), col = "green", lwd = 2)
legend("topright",
legend = c("Linear", "Quadratic", "Cubic"),
col = c("blue", "red", "green"),
lwd = 2)
evaluate_model <- function(model, test_data) {
predictions <- predict(model, newdata = test_data)
actuals <- test_data$mpg
mse <- mean((predictions - actuals)^2)
rmse <- sqrt(mse)
mad <- median(abs(predictions - actuals))
return(c(MSE = mse, RMSE = rmse, MAD = mad))
}
set.seed(12427550)
train_indices_50 <- sample(1:nrow(Auto), size = nrow(Auto) / 2)
train_data_50 <- Auto[train_indices_50, ]
test_data_50 <- Auto[-train_indices_50, ]
linear_model_50 <- lm(mpg ~ horsepower, data = train_data_50)
quadratic_model_50 <- lm(mpg ~ poly(horsepower, 2), data = train_data_50)
cubic_model_50 <- lm(mpg ~ poly(horsepower, 3), data = train_data_50)
results_50 <- data.frame(
Linear = evaluate_model(linear_model_50, test_data_50),
Quadratic = evaluate_model(quadratic_model_50, test_data_50),
Cubic = evaluate_model(cubic_model_50, test_data_50)
)
print(results_50)
