data("Auto")
str(Auto)
summary(Auto)
?Auto
linear_model <- tryCatch(glm(mpg ~ horsepower, data = Auto), error = function(e) NULL)
quadratic_model <- tryCatch(glm(mpg ~ poly(horsepower, 2), data = Auto), error = function(e) NULL)
cubic_model <- tryCatch(glm(mpg ~ poly(horsepower, 3), data = Auto), error = function(e) NULL)
if (!is.null(linear_model) & !is.null(quadratic_model) & !is.null(cubic_model)) {
