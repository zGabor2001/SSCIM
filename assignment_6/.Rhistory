print(paste("5-Fold CV MSE:", cv_5fold_cubic[1], "5-Fold CV RMSE:", cv_5fold_cubic[2]))
print(paste("10-Fold CV MSE:", cv_10fold_cubic[1], "10-Fold CV RMSE:", cv_10fold_cubic[2]))
data("economics")
linear_model <- glm(unemploy ~ uempmed, data = economics)
log_model <- glm(log(unemploy) ~ uempmed, data = economics)
poly2_model <- glm(unemploy ~ poly(uempmed, 2), data = economics)
poly3_model <- glm(unemploy ~ poly(uempmed, 3), data = economics)
poly10_model <- glm(unemploy ~ poly(uempmed, 10), data = economics)
plot(economics$uempmed, economics$unemploy, main = "Unemployed vs Median Days Unemployed", xlab = "Median Days Unemployed", ylab = "Number of Unemployed", pch = 16)
lines(economics$uempmed, predict(linear_model), col = "blue", lwd = 2)
lines(economics$uempmed, predict(log_model), col = "red", lwd = 2)
lines(economics$uempmed, predict(poly2_model), col = "green", lwd = 2)
lines(economics$uempmed, predict(poly3_model), col = "purple", lwd = 2)
lines(economics$uempmed, predict(poly10_model), col = "orange", lwd = 2)
legend("topright", legend = c("Linear", "Logarithmic", "Poly2", "Poly3", "Poly10"), col = c("blue", "red", "green", "purple", "orange"), lwd = 2)
perform_cv_economics <- function(model, data, folds) {
cv_result <- cv.glm(data, model, K = folds)
return(c(CV_MSE = cv_result$delta[1], CV_RMSE = sqrt(cv_result$delta[1])))
}
cv_loo_linear <- cv.glm(economics, linear_model)
cv_loo_log <- cv.glm(economics, log_model)
cv_loo_poly2 <- cv.glm(economics, poly2_model)
cv_loo_poly3 <- cv.glm(economics, poly3_model)
cv_loo_poly10 <- cv.glm(economics, poly10_model)
cv_5fold_linear <- perform_cv_economics(linear_model, economics, 5)
cv_5fold_log <- perform_cv_economics(log_model, economics, 5)
cv_5fold_poly2 <- perform_cv_economics(poly2_model, economics, 5)
cv_5fold_poly3 <- perform_cv_economics(poly3_model, economics, 5)
cv_5fold_poly10 <- perform_cv_economics(poly10_model, economics, 5)
cv_10fold_linear <- perform_cv_economics(linear_model, economics, 10)
cv_10fold_log <- perform_cv_economics(log_model, economics, 10)
cv_10fold_poly2 <- perform_cv_economics(poly2_model, economics, 10)
cv_10fold_poly3 <- perform_cv_economics(poly3_model, economics, 10)
cv_10fold_poly10 <- perform_cv_economics(poly10_model, economics, 10)
print("Model: Linear")
print(paste("LOO MSE:", cv_loo_linear$delta[1], "LOO RMSE:", sqrt(cv_loo_linear$delta[1])))
print(paste("5-Fold CV MSE:", cv_5fold_linear[1], "5-Fold CV RMSE:", cv_5fold_linear[2]))
print(paste("10-Fold CV MSE:", cv_10fold_linear[1], "10-Fold CV RMSE:", cv_10fold_linear[2]))
print("")
print("Model: Logarithmic")
print(paste("LOO MSE:", cv_loo_log$delta[1], "LOO RMSE:", sqrt(cv_loo_log$delta[1])))
print(paste("5-Fold CV MSE:", cv_5fold_log[1], "5-Fold CV RMSE:", cv_5fold_log[2]))
print(paste("10-Fold CV MSE:", cv_10fold_log[1], "10-Fold CV RMSE:", cv_10fold_log[2]))
print("")
print("Model: Poly2")
print(paste("LOO MSE:", cv_loo_poly2$delta[1], "LOO RMSE:", sqrt(cv_loo_poly2$delta[1])))
print(paste("5-Fold CV MSE:", cv_5fold_poly2[1], "5-Fold CV RMSE:", cv_5fold_poly2[2]))
print(paste("10-Fold CV MSE:", cv_10fold_poly2[1], "10-Fold CV RMSE:", cv_10fold_poly2[2]))
print("")
print("Model: Poly3")
print(paste("LOO MSE:", cv_loo_poly3$delta[1], "LOO RMSE:", sqrt(cv_loo_poly3$delta[1])))
print(paste("5-Fold CV MSE:", cv_5fold_poly3[1], "5-Fold CV RMSE:", cv_5fold_poly3[2]))
print(paste("10-Fold CV MSE:", cv_10fold_poly3[1], "10-Fold CV RMSE:", cv_10fold_poly3[2]))
print("")
print("Model: Poly10")
print(paste("LOO MSE:", cv_loo_poly10$delta[1], "LOO RMSE:", sqrt(cv_loo_poly10$delta[1])))
print(paste("5-Fold CV MSE:", cv_5fold_poly10[1], "5-Fold CV RMSE:", cv_5fold_poly10[2]))
print(paste("10-Fold CV MSE:", cv_10fold_poly10[1], "10-Fold CV RMSE:", cv_10fold_poly10[2]))
