perform_cv <- function(model, data, folds) {
cv_result <- cv.glm(data, model, K = folds)
return(c(CV_MSE = cv_result$delta[1], CV_RMSE = sqrt(cv_result$delta[1])))
}
cv_loo_linear <- cv.glm(Auto, linear_model)
cv_loo_quadratic <- cv.glm(Auto, quadratic_model)
cv_loo_cubic <- cv.glm(Auto, cubic_model)
cv_5fold_linear <- perform_cv(linear_model, Auto, 5)
cv_5fold_quadratic <- perform_cv(quadratic_model, Auto, 5)
cv_5fold_cubic <- perform_cv(cubic_model, Auto, 5)
cv_10fold_linear <- perform_cv(linear_model, Auto, 10)
cv_10fold_quadratic <- perform_cv(quadratic_model, Auto, 10)
cv_10fold_cubic <- perform_cv(cubic_model, Auto, 10)
