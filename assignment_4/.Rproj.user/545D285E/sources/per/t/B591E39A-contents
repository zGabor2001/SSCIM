#### 2.3 Use nonparametric bootstrap (for x and x.clean) to calculate for all 3 estimators: standard error, 95 percentile CI

``` {r task2c}
stat_func <- function(data, indices, stat_type) {
  sample <- tryCatch({
    data[indices]
  }, error = function(e) {
    message("Error in sample extraction: ", e$message)
    return(NULL)
  })
  
  if (is.null(sample)) return(NA)
  
  tryCatch({
    if (stat_type == "mean") return(mean(sample))
    if (stat_type == "median") return(median(sample))
    if (stat_type == "trimmed") return(mean(sample, trim = 0.05))
  }, error = function(e) {
    message("Error calculating statistic: ", e$message)
    return(NA)
  })
}

set.seed(123456)

bootstrap_results <- tryCatch({
  bootstrap_mean_x <- boot(data = x, statistic = stat_func, R = 2000, stat_type = "mean")
  bootstrap_median_x <- boot(data = x, statistic = stat_func, R = 2000, stat_type = "median")
  bootstrap_trimmed_x <- boot(data = x, statistic = stat_func, R = 2000, stat_type = "trimmed")
  
  bootstrap_mean_x_clean <- boot(data = x_clean, statistic = stat_func, R = 2000, stat_type = "mean")
  bootstrap_median_x_clean <- boot(data = x_clean, statistic = stat_func, R = 2000, stat_type = "median")
  bootstrap_trimmed_x_clean <- boot(data = x_clean, statistic = stat_func, R = 2000, stat_type = "trimmed")
  
  ci_mean_x <- boot.ci(bootstrap_mean_x, type = "perc")$percent[4:5]
  ci_median_x <- boot.ci(bootstrap_median_x, type = "perc")$percent[4:5]
  ci_trimmed_x <- boot.ci(bootstrap_trimmed_x, type = "perc")$percent[4:5]
  
  ci_mean_x_clean <- boot.ci(bootstrap_mean_x_clean, type = "perc")$percent[4:5]
  ci_median_x_clean <- boot.ci(bootstrap_median_x_clean, type = "perc")$percent[4:5]
  ci_trimmed_x_clean <- boot.ci(bootstrap_trimmed_x_clean, type = "perc")$percent[4:5]
  
  data.frame(
    Estimator = c("Mean", "Median", "Trimmed Mean (alpha=0.05)"),
    `SE (x)` = c(sd(bootstrap_mean_x$t), sd(bootstrap_median_x$t), sd(bootstrap_trimmed_x$t)),
    `95% CI (x)` = I(list(ci_mean_x, ci_median_x, ci_trimmed_x)),
    `SE (x_clean)` = c(sd(bootstrap_mean_x_clean$t), sd(bootstrap_median_x_clean$t), sd(bootstrap_trimmed_x_clean$t)),
    `95% CI (x_clean)` = I(list(ci_mean_x_clean, ci_median_x_clean, ci_trimmed_x_clean))
  )
}, error = function(e) {
  message("Error during bootstrapping process: ", e$message)
  return(NULL)
})

if (!is.null(bootstrap_results)) {
  print(bootstrap_results)
}

```

