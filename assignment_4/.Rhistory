stat_func <- function(data, indices, stat_type) {
sample <- tryCatch({
data[indices]
}, error = function(e) {
message("Error in sample extraction: ", e$message)
return(NULL)
})
if (is.null(sample)) return(NA)
tryCatch({
if (stat_type == "mean") return(mean(sample))
if (stat_type == "median") return(median(sample))
if (stat_type == "trimmed") return(mean(sample, trim = 0.05))
}, error = function(e) {
message("Error calculating statistic: ", e$message)
return(NA)
})
}
set.seed(123456)
bootstrap_results <- tryCatch({
bootstrap_mean_x <- boot(data = x, statistic = stat_func, R = 2000, stat_type = "mean")
bootstrap_median_x <- boot(data = x, statistic = stat_func, R = 2000, stat_type = "median")
bootstrap_trimmed_x <- boot(data = x, statistic = stat_func, R = 2000, stat_type = "trimmed")
bootstrap_mean_x_clean <- boot(data = x_clean, statistic = stat_func, R = 2000, stat_type = "mean")
bootstrap_median_x_clean <- boot(data = x_clean, statistic = stat_func, R = 2000, stat_type = "median")
bootstrap_trimmed_x_clean <- boot(data = x_clean, statistic = stat_func, R = 2000, stat_type = "trimmed")
ci_mean_x <- boot.ci(bootstrap_mean_x, type = "perc")$percent[4:5]
ci_median_x <- boot.ci(bootstrap_median_x, type = "perc")$percent[4:5]
ci_trimmed_x <- boot.ci(bootstrap_trimmed_x, type = "perc")$percent[4:5]
ci_mean_x_clean <- boot.ci(bootstrap_mean_x_clean, type = "perc")$percent[4:5]
ci_median_x_clean <- boot.ci(bootstrap_median_x_clean, type = "perc")$percent[4:5]
ci_trimmed_x_clean <- boot.ci(bootstrap_trimmed_x_clean, type = "perc")$percent[4:5]
data.frame(
Estimator = c("Mean", "Median", "Trimmed Mean (alpha=0.05)"),
`SE (x)` = c(sd(bootstrap_mean_x$t), sd(bootstrap_median_x$t), sd(bootstrap_trimmed_x$t)),
`95% CI (x)` = I(list(ci_mean_x, ci_median_x, ci_trimmed_x)),
`SE (x_clean)` = c(sd(bootstrap_mean_x_clean$t), sd(bootstrap_median_x_clean$t), sd(bootstrap_trimmed_x_clean$t)),
`95% CI (x_clean)` = I(list(ci_mean_x_clean, ci_median_x_clean, ci_trimmed_x_clean))
)
}, error = function(e) {
message("Error during bootstrapping process: ", e$message)
return(NULL)
})
if (!is.null(bootstrap_results)) {
print(bootstrap_results)
}
param_bootstrap <- function(data, n_bootstrap = 2000, estimator = "mean", distribution = "normal") {
n <- length(data)
results <- numeric(n_bootstrap)
tryCatch({
for (i in 1:n_bootstrap) {
if (distribution == "normal") {
sample <- rnorm(n, mean = mean(data), sd = sd(data))
}
if (estimator == "mean") {
results[i] <- mean(sample)
} else if (estimator == "trimmed") {
results[i] <- mean(sample, trim = 0.05)
}
}
bias <- mean(results) - mean(data)
se <- sd(results)
ci <- quantile(results, probs = c(0.025, 0.975))
bias_corrected_estimate <- mean(data) - bias
list(bias = bias, se = se, ci = ci, bias_corrected_estimate = bias_corrected_estimate)
}, error = function(e) {
message("Error in parametric bootstrap: ", e$message)
return(NULL)
})
}
tryCatch({
param_mean_x <- param_bootstrap(x, estimator = "mean")
param_trimmed_x <- param_bootstrap(x, estimator = "trimmed")
param_mean_x_clean <- param_bootstrap(x_clean, estimator = "mean")
param_trimmed_x_clean <- param_bootstrap(x_clean, estimator = "trimmed")
parametric_results <- data.frame(
Estimator = c("Mean (x)", "Trimmed Mean (x)", "Mean (x_clean)", "Trimmed Mean (x_clean)"),
Bias = c(param_mean_x$bias, param_trimmed_x$bias, param_mean_x_clean$bias, param_trimmed_x_clean$bias),
SE = c(param_mean_x$se, param_trimmed_x$se, param_mean_x_clean$se, param_trimmed_x_clean$se),
`95% CI` = I(list(param_mean_x$ci, param_trimmed_x$ci, param_mean_x_clean$ci, param_trimmed_x_clean$ci)),
`Bias-corrected Estimate` = c(param_mean_x$bias_corrected_estimate, param_trimmed_x$bias_corrected_estimate,
param_mean_x_clean$bias_corrected_estimate, param_trimmed_x_clean$bias_corrected_estimate)
)
print(parametric_results)
}, error = function(e) {
message("Error during parametric bootstrap process: ", e$message)
})
try({
print(bootstrap_results)
print(parametric_results)
}, silent = FALSE)
try({
par(mfrow = c(2, 1))
hist(bootstrap_mean_x$t, main = "Non-parametric Bootstrap for Mean (x)", xlab = "Mean", col = "skyblue")
abline(v = mean_x, col = "red", lwd = 2)
hist(bootstrap_mean_x_clean$t, main = "Non-parametric Bootstrap for Mean (x_clean)", xlab = "Mean", col = "lightgreen")
abline(v = mean_x_clean, col = "red", lwd = 2)
}, silent = FALSE)
