bias <- mean(results) - mean(data)
se <- sd(results)
ci <- quantile(results, probs = c(0.025, 0.975))
bias_corrected_estimate <- mean(data) - bias
list(bias = bias, se = se, ci = ci, bias_corrected_estimate = bias_corrected_estimate)
